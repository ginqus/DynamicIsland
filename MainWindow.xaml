<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland"
        Title="Dynamic Island" Width="680" Height="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        Focusable="False" UseLayoutRounding="True"
        FontFamily="./Fonts/#SF Pro Text, SF Pro Text, Segoe UI Variable Display, Segoe UI" Foreground="White">

    <Window.Resources>
        <SolidColorBrush x:Key="Dim" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="Orange" Color="#FF9F0A"/>
        <SolidColorBrush x:Key="Green" Color="#30D158"/>
        <SolidColorBrush x:Key="Red" Color="#FF453A"/>
        <SolidColorBrush x:Key="Indigo" Color="#7D7AFF"/>

        <LinearGradientBrush x:Key="ArtPlaceholder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#48484A" Offset="0"/>
            <GradientStop Color="#1C1C1E" Offset="1"/>
        </LinearGradientBrush>

        <!-- round media button: soft hover disc + squish on press -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Squish"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Disc" Fill="White" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Squish" Storyboard.TargetProperty="ScaleX" To="0.82" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="Squish" Storyboard.TargetProperty="ScaleY" To="0.82" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Squish" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Squish" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- menu row: nothing but its content and a place to click. The highlight is the list's (RowList),
             one for all the rows -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <local:ChipCorners x:Key="ChipCorners"/>

        <!-- small filled pill: timer presets, and the start button with its own background -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ChipCorners}}" Background="{TemplateBinding Background}"/>
                            <Border x:Name="Shine" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ChipCorners}}" Background="White" Opacity="0"/>
                            <Border x:Name="Press" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ChipCorners}}" Background="White" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0.1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0.13" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a place to click with nothing of its own drawn: its content says what it is -->
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a colour to pick: a dot in its Background, with a ring around the one that is picked -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="24" Height="24" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="1.5" Opacity="0"/>
                            <Ellipse Margin="5" Fill="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Swell"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleX" To="1.18" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleY" To="1.18" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="Swell" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- moved down by the gap to the top of the screen and scaled to the size picked in the menu: the island grows
         down and sideways from the middle of its top edge. The window is made larger than this to hold it then -->
    <Grid x:Name="Root" Width="620" Height="410" Opacity="0"
          HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0"
          MouseLeftButtonDown="Root_MouseLeftButtonDown" MouseLeftButtonUp="Root_MouseLeftButtonUp"
          MouseRightButtonUp="Root_MouseRightButtonUp" MouseUp="Root_MouseUp" MouseWheel="Root_MouseWheel"
          AllowDrop="True" DragEnter="Root_DragOver" DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop">
        <Grid.RenderTransform>
            <TransformGroup>
                <TranslateTransform x:Name="RootMove"/>
                <ScaleTransform x:Name="RootSize"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- the pill and everything in it: one piece under the pointer, scaled from its top centre -->
        <Grid x:Name="Island" RenderTransformOrigin="0.5,0"
              MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="IslandScale"/>
            </Grid.RenderTransform>

            <!-- in the body's own outline, which the code gives it -->
            <Path x:Name="Shadow" Fill="Black" Opacity="0" IsHitTestVisible="False"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="38" ShadowDepth="10" Direction="270" Opacity="0.6" Color="Black"/>
                </Path.Effect>
            </Path>

            <!-- the black itself, the bubble's included -->
            <local:Goo x:Name="Body" IsHitTestVisible="False"/>

            <!-- what the pointer lands on -->
            <Border x:Name="Pill" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Top"/>

            <!-- every state lives here at its final size; the pill clip reveals it -->
            <Grid x:Name="Host">

                <!-- idle: clock -->
                <Grid x:Name="IdleView" Width="118" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <local:Digits x:Name="IdleClock" Text="00:00" FontSize="13.5" FontWeight="SemiBold"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- compact now-playing: the cover on its left and the bars on its right are the ones the toast and the
                     player show too, kept in a layer of their own over the views -->
                <Grid x:Name="MediaView" Width="210" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <!-- synced lyric line: long lines scroll sideways, both edges fade into the pill -->
                    <Canvas x:Name="LyricBox" Height="34" Margin="36,0,41,0"
                            Background="Transparent" ClipToBounds="True" IsHitTestVisible="False"
                            SizeChanged="LyricBox_SizeChanged">
                        <Canvas.OpacityMask>
                            <LinearGradientBrush x:Name="LyricMask" MappingMode="Absolute" StartPoint="0,0" EndPoint="133,0">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop x:Name="LyricMaskIn" Color="Black" Offset="0.06"/>
                                <GradientStop x:Name="LyricMaskOut" Color="Black" Offset="0.94"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Canvas.OpacityMask>
                        <TextBlock x:Name="LyricA" FontSize="12" FontWeight="Medium" Opacity="0"
                                   TextOptions.TextHintingMode="Animated">
                            <TextBlock.RenderTransform>
                                <TranslateTransform/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="LyricB" FontSize="12" FontWeight="Medium" Opacity="0"
                                   TextOptions.TextHintingMode="Animated">
                            <TextBlock.RenderTransform>
                                <TranslateTransform/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                </Grid>

                <!-- compact countdown -->
                <Grid x:Name="TimerView" Width="132" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <local:Ring x:Name="TimerRing" Width="18" Height="18" Stroke="{StaticResource Orange}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0"/>
                    <local:Digits x:Name="TimerText" Text="25:00" FontSize="13.5" FontWeight="SemiBold"
                                  Foreground="{StaticResource Orange}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                </Grid>

                <!-- volume HUD -->
                <Grid x:Name="VolumeView" Width="250" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="162"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <local:Icon x:Name="VolIcon" Kind="Loud" Width="17" Height="17"/>
                    <!-- pushed past either end, the bar stretches that way and springs back -->
                    <Grid x:Name="VolTrack" Grid.Column="1" Height="5" VerticalAlignment="Center">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="VolStretch"/>
                        </Grid.RenderTransform>
                        <Border CornerRadius="2.5" Background="#33FFFFFF"/>
                        <Border x:Name="VolFill" CornerRadius="2.5" Background="White" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                    <local:Digits x:Name="VolText" Grid.Column="2" Text="0" FontSize="12.5" FontWeight="SemiBold"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- charger plugged in -->
                <Grid x:Name="ChargeView" Width="230" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <!-- the bolt strikes as the view comes in -->
                    <local:Icon x:Name="ChargeBolt" Kind="Bolt" Width="16" Height="16" Fill="{StaticResource Green}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                RenderTransformOrigin="0.5,0.5">
                        <local:Icon.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="BoltSize"/>
                                <RotateTransform x:Name="BoltTurn"/>
                            </TransformGroup>
                        </local:Icon.RenderTransform>
                    </local:Icon>
                    <TextBlock Text="Зарядка" FontSize="13" FontWeight="SemiBold" Margin="33,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0">
                        <local:Digits x:Name="ChargeText" Text="100%" FontSize="13" FontWeight="SemiBold" Foreground="#30D158"
                                      VerticalAlignment="Center"/>
                        <Grid Width="27" Height="13" Margin="7,0,0,0" VerticalAlignment="Center">
                            <Border Width="24" HorizontalAlignment="Left" CornerRadius="4" BorderBrush="#66FFFFFF" BorderThickness="1"/>
                            <Border x:Name="ChargeFill" Width="20" Height="9" Margin="2,0,0,0" CornerRadius="2.5" Background="#30D158"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Border Width="2" Height="5" CornerRadius="0,1,1,0" Background="#66FFFFFF"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- "Do not disturb" turned on or off -->
                <Grid x:Name="FocusView" Width="236" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <local:Icon x:Name="FocusIcon" Kind="Moon" Width="18" Height="18" Fill="{StaticResource Indigo}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                RenderTransformOrigin="0.5,0.5">
                        <local:Icon.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="FocusSize"/>
                                <RotateTransform x:Name="FocusTurn"/>
                            </TransformGroup>
                        </local:Icon.RenderTransform>
                    </local:Icon>
                    <TextBlock Text="Не беспокоить" FontSize="13" FontWeight="SemiBold" Margin="39,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FocusText" Text="Вкл." FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Indigo}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/>
                </Grid>

                <!-- track changed -->
                <Grid x:Name="ToastView" Width="340" Height="68" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Margin="68,0,58,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ToastArtist" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- one-off notice: audio device, network, timer finished -->
                <Grid x:Name="NoticeView" Width="320" Height="64" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <!-- the square takes a faint wash of the icon's colour, and each kind of notice brings its icon in
                         in its own way: the code sets both -->
                    <Border x:Name="NoticeBack" Width="40" Height="40" CornerRadius="11" Background="#1FFFFFFF"
                            HorizontalAlignment="Left" Margin="12,0,0,0">
                        <local:Icon x:Name="NoticeIcon" Width="22" Height="22" RenderTransformOrigin="0.5,0.5">
                            <local:Icon.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="NoticeSize"/>
                                    <RotateTransform x:Name="NoticeTurn"/>
                                    <TranslateTransform x:Name="NoticeMove"/>
                                </TransformGroup>
                            </local:Icon.RenderTransform>
                        </local:Icon>
                    </Border>
                    <StackPanel Margin="64,0,22,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NoticeTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NoticeText" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- expanded player -->
                <Grid x:Name="MediaBigView" Width="380" Height="176" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <!-- the view grows taller with lyrics (the code sets its height): the light and the controls keep
                         to the bottom edge, the lyrics take the room that opens above them -->
                    <local:Aura x:Name="Glow" Height="176" VerticalAlignment="Bottom" IsHitTestVisible="False"/>

                    <!-- between the cover and the bars -->
                    <Grid Height="64" Margin="20,20,22,0" VerticalAlignment="Top">
                        <StackPanel Margin="78,0,52,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleBig" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ArtistBig" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <!-- synced lyrics: the line being sung in the middle, its neighbours fading out above and below -->
                    <Canvas x:Name="PlayerLyricBox" Width="340" Height="70" Margin="0,92,0,0" Opacity="0"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Background="Transparent" ClipToBounds="True" IsHitTestVisible="False">
                        <Canvas.OpacityMask>
                            <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,70">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="Black" Offset="0.2"/>
                                <GradientStop Color="Black" Offset="0.8"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Canvas.OpacityMask>
                        <!-- while the lyrics are looked up, faint lines with a sheen running through them hold their place -->
                        <local:Shimmer x:Name="PlayerLyricWait" Width="340" Height="70" Opacity="0"/>
                        <Canvas x:Name="PlayerLyricLines">
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="PlayerLyricMove"/>
                            </Canvas.RenderTransform>
                        </Canvas>
                    </Canvas>

                    <Grid Height="20" Margin="20,0,20,59" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <local:Digits x:Name="PosText" Text="0:00" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                        <Border x:Name="SeekArea" Grid.Column="1" Background="Transparent" Cursor="Hand"
                                MouseLeftButtonDown="Seek_MouseLeftButtonDown" MouseMove="Seek_MouseMove"
                                MouseLeftButtonUp="Seek_MouseLeftButtonUp" LostMouseCapture="Seek_LostMouseCapture">
                            <Grid x:Name="SeekBar" Height="6" VerticalAlignment="Center">
                                <Border x:Name="SeekBack" CornerRadius="3" Background="#33FFFFFF"/>
                                <Border x:Name="SeekFill" CornerRadius="3" Background="White" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                        </Border>
                        <local:Digits x:Name="RemText" Grid.Column="2" Text="-0:00" FontSize="11" Foreground="{StaticResource Dim}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Button Style="{StaticResource IconButton}" Click="Prev_Click">
                            <Path Data="M22,1 L12,7.5 L22,14 Z M11,1 L1,7.5 L11,14 Z" Fill="White" Stroke="White"
                                  StrokeThickness="2" StrokeLineJoin="Round"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="52" Height="52" Margin="16,0" Click="Play_Click">
                            <!-- the two trade places: one shrinks away as the other comes in -->
                            <Grid>
                                <Path x:Name="PlayIcon" Data="M2,1 L16,10 L2,19 Z" Fill="White" Stroke="White" Margin="4,0,0,0"
                                      StrokeThickness="2.5" StrokeLineJoin="Round"/>
                                <Path x:Name="PauseIcon" Data="M1,1 H6 V19 H1 Z M12,1 H17 V19 H12 Z" Fill="White" Stroke="White"
                                      StrokeThickness="2" StrokeLineJoin="Round" Opacity="0"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="Next_Click">
                            <Path Data="M1,1 L11,7.5 L1,14 Z M12,1 L22,7.5 L12,14 Z" Fill="White" Stroke="White"
                                  StrokeThickness="2" StrokeLineJoin="Round"/>
                        </Button>
                    </StackPanel>

                    <!-- charge of the Bluetooth headphones the sound goes to, level with the buttons -->
                    <StackPanel x:Name="PlayerHeadset" Orientation="Horizontal" Height="52" Margin="0,0,20,8"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                Visibility="Collapsed">
                        <local:Icon x:Name="PlayerHeadsetIcon" Kind="Headphones" Width="14" Height="14"
                                    Fill="{StaticResource Dim}" VerticalAlignment="Center"/>
                        <local:Digits x:Name="PlayerHeadsetText" FontSize="11" Foreground="{StaticResource Dim}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- the volume the wheel has just moved, across from the headphones: it comes up and fades.
                         A note for the app that plays, the speaker for the whole system -->
                    <StackPanel x:Name="PlayerVolume" Orientation="Horizontal" Height="52" Margin="20,0,0,8"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                Opacity="0">
                        <local:Icon x:Name="PlayerVolumeIcon" Kind="Note" Width="14" Height="14"
                                    Fill="{StaticResource Dim}" VerticalAlignment="Center"/>
                        <local:Digits x:Name="PlayerVolumeText" FontSize="11" Foreground="{StaticResource Dim}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- expanded, nothing playing -->
                <Grid x:Name="IdleBigView" Width="320" Height="124" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Margin="26,0,0,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <local:Digits x:Name="BigClock" Text="00:00" FontSize="46" FontWeight="SemiBold"
                                      FontFamily="./Fonts/#SF Pro Display, SF Pro Display, Segoe UI Variable Display, Segoe UI"/>
                        <StackPanel Orientation="Horizontal" Margin="2,-4,0,0">
                            <TextBlock x:Name="BigDate" FontSize="13" Foreground="{StaticResource Dim}"/>
                            <!-- next to the date while "Do not disturb" is on, as on a locked phone -->
                            <local:Icon x:Name="InfoFocus" Kind="Moon" Width="13" Height="13" Fill="{StaticResource Indigo}"
                                        Margin="6,1,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <local:Icon x:Name="InfoVolIcon" Kind="Loud" Width="16" Height="16"
                                        Fill="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <local:Digits x:Name="InfoVol" Text="—" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                          VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="InfoHeadsetRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"
                                    Visibility="Collapsed">
                            <local:Icon x:Name="InfoHeadsetIcon" Kind="Headphones" Width="16" Height="16"
                                        Fill="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <local:Digits x:Name="InfoHeadset" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                          VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="InfoBatRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"
                                    Visibility="Collapsed">
                            <local:Icon Kind="Battery" Width="16" Height="16"
                                        Fill="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <local:Digits x:Name="InfoBat" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                          VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- expanded countdown -->
                <Grid x:Name="TimerBigView" Width="330" Height="92" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Button Style="{StaticResource IconButton}" Width="50" Height="50" Click="TimerToggle_Click">
                            <Grid Width="50" Height="50">
                                <!-- what is left of the countdown runs round the button -->
                                <local:Ring x:Name="BigRing" Thickness="3" Stroke="{StaticResource Orange}" RenderTransformOrigin="0.5,0.5"/>
                                <Ellipse x:Name="TimerDisc" Margin="6" Fill="{StaticResource Orange}" Opacity="0.25"/>
                                <Path x:Name="TimerPauseIcon" Data="M1,1 H5 V15 H1 Z M10,1 H14 V15 H10 Z"
                                      Fill="{StaticResource Orange}" Stroke="{StaticResource Orange}"
                                      StrokeThickness="2" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path x:Name="TimerPlayIcon" Data="M2,1 L13,8 L2,15 Z" Margin="3,0,0,0" Opacity="0"
                                      Fill="{StaticResource Orange}" Stroke="{StaticResource Orange}"
                                      StrokeThickness="2" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="50" Height="50" Margin="10,0,0,0" Click="TimerCancel_Click">
                            <Grid Width="50" Height="50">
                                <Ellipse Fill="#2EFFFFFF"/>
                                <Path Data="M1,1 L13,13 M13,1 L1,13" Stroke="White" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,26,2">
                        <TextBlock x:Name="BigTimerLabel" Text="Таймер" FontSize="12" Foreground="{StaticResource Orange}"
                                   Opacity="0.8" HorizontalAlignment="Right"/>
                        <local:Digits x:Name="BigTimer" Text="25:00" FontSize="40" FontWeight="SemiBold"
                                      FontFamily="./Fonts/#SF Pro Display, SF Pro Display, Segoe UI Variable Display, Segoe UI"
                                      Foreground="{StaticResource Orange}"
                                      HorizontalAlignment="Right" Margin="0,-4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- new countdown: −/+, a preset or the mouse wheel sets the minutes -->
                <Grid x:Name="TimerSetView" Width="300" Height="190" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Margin="14,14,14,0">
                        <TextBlock Text="ТАЙМЕР" FontSize="10.5" FontWeight="SemiBold" Foreground="#66FFFFFF"
                                   Margin="8,0,0,0"/>
                        <Grid Height="56">
                            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Left" Click="TimerLess_Click">
                                <local:Icon Kind="Minus" Width="16" Height="16"/>
                            </Button>
                            <local:Digits x:Name="SetupText" Text="25:00" FontSize="38" FontWeight="SemiBold"
                                          FontFamily="./Fonts/#SF Pro Display, SF Pro Display, Segoe UI Variable Display, Segoe UI"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="TimerMore_Click">
                                <local:Icon Kind="Plus" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                        <UniformGrid Rows="1" Margin="0,4,0,0">
                            <Button Style="{StaticResource ChipButton}" Tag="5" Content="5 мин" Click="TimerPreset_Click"/>
                            <Button Style="{StaticResource ChipButton}" Tag="10" Content="10 мин" Click="TimerPreset_Click"/>
                            <Button Style="{StaticResource ChipButton}" Tag="15" Content="15 мин" Click="TimerPreset_Click"/>
                            <Button Style="{StaticResource ChipButton}" Tag="25" Content="25 мин" Click="TimerPreset_Click"/>
                            <Button Style="{StaticResource ChipButton}" Tag="45" Content="45 мин" Click="TimerPreset_Click"/>
                        </UniformGrid>
                        <Button Style="{StaticResource ChipButton}" Height="36" Margin="2,10,2,0" Content="Запустить"
                                Background="{StaticResource Orange}" Foreground="Black" FontSize="13.5" FontWeight="SemiBold"
                                Click="TimerStart_Click"/>
                    </StackPanel>
                </Grid>

                <!-- right-click menu -->
                <Grid x:Name="MenuView" Width="300" Height="248" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <local:RowList Margin="10,14,10,0">
                        <TextBlock Text="DYNAMIC ISLAND" FontSize="10.5" FontWeight="SemiBold" Foreground="#66FFFFFF"
                                   Margin="12,0,0,6"/>
                        <Button Style="{StaticResource RowButton}" Click="TimerRow_Click">
                            <Grid>
                                <local:Icon Kind="Clock" Width="17" Height="17" Fill="{StaticResource Dim}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="Таймер" Margin="29,0,0,0" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <local:Digits x:Name="MenuTimer" Foreground="{StaticResource Orange}" VerticalAlignment="Center"/>
                                    <local:Icon Kind="Chevron" Width="11" Height="11"
                                                Fill="{StaticResource Dim}" Margin="8,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Click="ShelfRow_Click">
                            <Grid>
                                <local:Icon Kind="Tray" Width="17" Height="17" Fill="{StaticResource Dim}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="Полка" Margin="29,0,0,0" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <local:Digits x:Name="MenuShelf" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                                    <local:Icon Kind="Chevron" Width="11" Height="11"
                                                Fill="{StaticResource Dim}" Margin="8,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Click="SettingsRow_Click">
                            <Grid>
                                <local:Icon Kind="Gear" Width="17" Height="17" Fill="{StaticResource Dim}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="Настройки" Margin="29,0,0,0" VerticalAlignment="Center"/>
                                <local:Icon Kind="Chevron" Width="11" Height="11" Fill="{StaticResource Dim}"
                                            Margin="0,1,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Click="LookRow_Click">
                            <Grid>
                                <local:Icon Kind="Look" Width="17" Height="17" Fill="{StaticResource Dim}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="Оформление" Margin="29,0,0,0" VerticalAlignment="Center"/>
                                <local:Icon Kind="Chevron" Width="11" Height="11" Fill="{StaticResource Dim}"
                                            Margin="0,1,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Click="Exit_Click">
                            <Grid>
                                <local:Icon Kind="Power" Width="17" Height="17" Fill="{StaticResource Red}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="Закрыть остров" Foreground="{StaticResource Red}" Margin="29,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </local:RowList>
                </Grid>

                <!-- its second page: the switches. The heading leads back -->
                <Grid x:Name="SettingsView" Width="320" Height="374" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <local:RowList Margin="10,8,10,0">
                        <Button Style="{StaticResource RowButton}" Height="32" Margin="0,0,0,2" Click="SettingsBack_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <local:Icon Kind="Back" Width="10" Height="10" Fill="#66FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock Text="НАСТРОЙКИ" FontSize="10.5" FontWeight="SemiBold" Foreground="#66FFFFFF"
                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Click="Lyrics_Click">
                            <Grid>
                                <local:Icon Kind="Lines" Width="17" Height="17" Fill="{StaticResource Dim}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="Текст песен" Margin="29,0,0,0" VerticalAlignment="Center"/>
                                <local:Toggle x:Name="LyricsSwitch" Width="38" Height="22" HorizontalAlignment="Right"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Click="LyricEffects_Click">
                            <Grid>
                                <local:Icon Kind="Sparkle" Width="17" Height="17" Fill="{StaticResource Dim}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="Эффекты текста" Margin="29,0,0,0" VerticalAlignment="Center"/>
                                <local:Toggle x:Name="LyricEffectsSwitch" Width="38" Height="22" HorizontalAlignment="Right"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Click="Rim_Click">
                            <Grid>
                                <local:Icon Kind="Rim" Width="17" Height="17" Fill="{StaticResource Dim}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="Цветной ободок" Margin="29,0,0,0" VerticalAlignment="Center"/>
                                <local:Toggle x:Name="RimSwitch" Width="38" Height="22" HorizontalAlignment="Right"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Click="AppVolume_Click">
                            <Grid>
                                <local:Icon Kind="Mid" Width="17" Height="17" Fill="{StaticResource Dim}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="Громкость приложения" Margin="29,0,0,0" VerticalAlignment="Center"/>
                                <local:Toggle x:Name="AppVolumeSwitch" Width="38" Height="22" HorizontalAlignment="Right"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Click="AppSpectrum_Click">
                            <Grid>
                                <local:Icon Kind="Mid" Width="17" Height="17" Fill="{StaticResource Dim}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="Спектр приложения" Margin="29,0,0,0" VerticalAlignment="Center"/>
                                <local:Toggle x:Name="AppSpectrumSwitch" Width="38" Height="22" HorizontalAlignment="Right"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Click="Network_Click">
                            <Grid>
                                <local:Icon Kind="Wifi" Width="17" Height="17" Fill="{StaticResource Dim}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="Уведомления о сети" Margin="29,0,0,0" VerticalAlignment="Center"/>
                                <local:Toggle x:Name="NetworkSwitch" Width="38" Height="22" HorizontalAlignment="Right"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Click="Fullscreen_Click">
                            <Grid>
                                <local:Icon Kind="Expand" Width="17" Height="17" Fill="{StaticResource Dim}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="Скрывать на полном экране" Margin="29,0,0,0" VerticalAlignment="Center"/>
                                <local:Toggle x:Name="FullscreenSwitch" Width="38" Height="22" HorizontalAlignment="Right"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Click="Autostart_Click">
                            <Grid>
                                <local:Icon Kind="Windows" Width="17" Height="17" Fill="{StaticResource Dim}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="Запускать с Windows" Margin="29,0,0,0" VerticalAlignment="Center"/>
                                <local:Toggle x:Name="AutostartSwitch" Width="38" Height="22" HorizontalAlignment="Right"/>
                            </Grid>
                        </Button>
                    </local:RowList>
                </Grid>

                <!-- its third: how the island looks. A click on a row steps to its next value and the wheel goes
                     both ways; the colours are picked straight from the strip -->
                <Grid x:Name="LookView" Width="320" Height="248" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <local:RowList Margin="10,8,10,0">
                        <Button Style="{StaticResource RowButton}" Height="32" Margin="0,0,0,2" Click="SettingsBack_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <local:Icon Kind="Back" Width="10" Height="10" Fill="#66FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock Text="ОФОРМЛЕНИЕ" FontSize="10.5" FontWeight="SemiBold" Foreground="#66FFFFFF"
                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SizeRow" Style="{StaticResource RowButton}" Click="Size_Click">
                            <Grid>
                                <local:Icon Kind="Size" Width="17" Height="17" Fill="{StaticResource Dim}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="Размер" Margin="29,0,0,0" VerticalAlignment="Center"/>
                                <local:Digits x:Name="SizeText" Foreground="{StaticResource Dim}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button x:Name="GapRow" Style="{StaticResource RowButton}" Click="Gap_Click">
                            <Grid>
                                <local:Icon Kind="Gap" Width="17" Height="17" Fill="{StaticResource Dim}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="Отступ от края" Margin="29,0,0,0" VerticalAlignment="Center"/>
                                <local:Digits x:Name="GapText" Foreground="{StaticResource Dim}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <!-- how brightly the edge lights up on the bass of the music -->
                        <Button x:Name="PulseRow" Style="{StaticResource RowButton}" Click="Pulse_Click">
                            <Grid>
                                <local:Icon Kind="Pulse" Width="17" Height="17" Fill="{StaticResource Dim}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="Пульс ободка" Margin="29,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PulseText" Foreground="{StaticResource Dim}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Grid Height="40" Margin="12,0">
                            <local:Icon Kind="Drop" Width="17" Height="17" Fill="{StaticResource Dim}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="Акцентный цвет" FontSize="13.5" Margin="29,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AccentText" FontSize="13.5" Foreground="{StaticResource Dim}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- the first leaves the colour to the cover -->
                        <UniformGrid x:Name="AccentStrip" Rows="1" Height="30" Margin="8,0">
                            <RadioButton Style="{StaticResource Swatch}" Tag="Из обложки" Click="Accent_Click">
                                <RadioButton.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF375F" Offset="0"/>
                                        <GradientStop Color="#FFD60A" Offset="0.35"/>
                                        <GradientStop Color="#30D158" Offset="0.65"/>
                                        <GradientStop Color="#0A84FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </RadioButton.Background>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Swatch}" Background="#FFFFFF" Tag="Белый" Click="Accent_Click"/>
                            <RadioButton Style="{StaticResource Swatch}" Background="#FF453A" Tag="Красный" Click="Accent_Click"/>
                            <RadioButton Style="{StaticResource Swatch}" Background="#FF9F0A" Tag="Оранжевый" Click="Accent_Click"/>
                            <RadioButton Style="{StaticResource Swatch}" Background="#FFD60A" Tag="Жёлтый" Click="Accent_Click"/>
                            <RadioButton Style="{StaticResource Swatch}" Background="#30D158" Tag="Зелёный" Click="Accent_Click"/>
                            <RadioButton Style="{StaticResource Swatch}" Background="#64D2FF" Tag="Голубой" Click="Accent_Click"/>
                            <RadioButton Style="{StaticResource Swatch}" Background="#0A84FF" Tag="Синий" Click="Accent_Click"/>
                            <RadioButton Style="{StaticResource Swatch}" Background="#BF5AF2" Tag="Фиолетовый" Click="Accent_Click"/>
                            <RadioButton Style="{StaticResource Swatch}" Background="#FF375F" Tag="Розовый" Click="Accent_Click"/>
                        </UniformGrid>
                    </local:RowList>
                </Grid>

                <!-- the shelf: files put down on the island, to be dragged out somewhere else. A file dragged over the
                     island opens it, the place to drop it outlined -->
                <Grid x:Name="ShelfView" Width="380" Height="136" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Height="22" Margin="22,12,16,0" VerticalAlignment="Top">
                        <TextBlock Text="ПОЛКА" FontSize="10.5" FontWeight="SemiBold" Foreground="#66FFFFFF"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- files picked from the computer, for when there is nothing at hand to drag -->
                            <Button Style="{StaticResource ChipButton}" Width="22" Height="22" Margin="0,0,6,0" Click="ShelfAdd_Click">
                                <local:Icon Kind="Plus" Width="12" Height="12" Fill="{StaticResource Dim}"/>
                            </Button>
                            <Button x:Name="ShelfClear" Style="{StaticResource ChipButton}" Height="22" Margin="0" FontSize="11"
                                    Click="ShelfClear_Click">
                                <TextBlock Text="Очистить" Margin="10,0" Foreground="{StaticResource Dim}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Rectangle x:Name="ShelfZone" Margin="14,40,14,12" RadiusX="16" RadiusY="16"
                               Stroke="White" StrokeThickness="1.5" StrokeDashArray="3 2.5" Fill="#0AFFFFFF" Opacity="0"
                               IsHitTestVisible="False"/>
                    <!-- the empty shelf is one place to click: it opens the files of the computer -->
                    <Button x:Name="ShelfHint" Style="{StaticResource PlainButton}" Margin="14,40,14,12" Click="ShelfAdd_Click"
                            MouseEnter="ShelfHint_MouseHover" MouseLeave="ShelfHint_MouseHover">
                        <StackPanel>
                            <local:Icon Kind="Tray" Width="22" Height="22" Fill="{StaticResource Dim}"/>
                            <TextBlock x:Name="ShelfHintText" Text="Перетащите сюда файлы" FontSize="12" Foreground="{StaticResource Dim}"
                                       Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ShelfHintMore" Text="или нажмите, чтобы выбрать" FontSize="11" Foreground="#66FFFFFF"
                                       Margin="0,1,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- room above the tiles for the crosses on their corners; more than fit are scrolled by the wheel -->
                    <Border x:Name="ShelfStrip" Margin="18,36,18,10" ClipToBounds="True">
                        <!-- the row fades out at an end it goes on past -->
                        <Border.OpacityMask>
                            <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="344,0">
                                <GradientStop x:Name="ShelfEdgeLeft" Color="Black" Offset="0"/>
                                <GradientStop Color="Black" Offset="0.05"/>
                                <GradientStop Color="Black" Offset="0.95"/>
                                <GradientStop x:Name="ShelfEdgeRight" Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                        <!-- the canvas lets the row be as long as it is: laid out in the strip alone, it would be cut to the
                             strip's width before the wheel moves it, and the tiles past the fifth never seen -->
                        <Canvas>
                            <StackPanel x:Name="ShelfTiles" Orientation="Horizontal" Margin="0,8,0,0">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="ShelfMove"/>
                                </StackPanel.RenderTransform>
                            </StackPanel>
                        </Canvas>
                    </Border>
                </Grid>
            </Grid>

            <!-- the cover and the bars of the music. The pill, the toast and the player each leave a place for them, and
                 these are the same two in all three: from one view to the next they do not fade out and come back, they
                 move over and grow or shrink, on springs like the pill's own. Cut to the pill as the views are -->
            <Canvas x:Name="Shared" Visibility="Collapsed" Opacity="0">
                <!-- laid out at the size the player shows it and scaled down for the others; in the player it leads to
                     the app that plays -->
                <Grid x:Name="ArtSpot" Width="64" Height="64" MouseLeftButtonUp="Art_MouseLeftButtonUp">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ArtSize"/>
                            <TranslateTransform x:Name="ArtMove"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Border Background="{StaticResource ArtPlaceholder}">
                        <local:Icon Kind="Note" Width="30" Height="30" Fill="{StaticResource Dim}"/>
                    </Border>
                    <local:Cover x:Name="Art" Radius="16"/>
                </Grid>
                <local:Equalizer x:Name="Eq" Bars="8" Few="5" Width="21" Height="16" IsHitTestVisible="False">
                    <local:Equalizer.RenderTransform>
                        <TranslateTransform x:Name="EqMove"/>
                    </local:Equalizer.RenderTransform>
                </local:Equalizer>
            </Canvas>
        </Grid>

        <!-- a second activity (the timer, while the pill is busy with something else) splits off into its own
             bubble: it starts inside the pill's right end and is pulled out of it. Its black is part of the
             body the island draws, this is what it shows. It answers the pointer on its own, growing away
             from the pill so the gap between them holds -->
        <Border x:Name="Bubble" Width="78" Height="34" CornerRadius="17" Visibility="Collapsed"
                Background="Transparent" Padding="1"
                HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0,0"
                MouseEnter="Bubble_MouseEnter" MouseLeave="Bubble_MouseLeave"
                MouseLeftButtonDown="Bubble_MouseLeftButtonDown" MouseLeftButtonUp="Bubble_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BubbleScale"/>
                    <TranslateTransform x:Name="BubbleMove"/>
                </TransformGroup>
            </Border.RenderTransform>
            <!-- it carries the timer, the shelf or both side by side; the code sets its width to what it carries -->
            <Grid x:Name="BubbleBody" ClipToBounds="True">
                <Grid x:Name="BubbleTimer" Width="76" HorizontalAlignment="Left">
                    <local:Ring x:Name="BubbleRing" Width="16" Height="16" Stroke="{StaticResource Orange}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <local:Digits x:Name="BubbleText" Text="25:00" FontSize="12.5" FontWeight="SemiBold"
                                  Foreground="{StaticResource Orange}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </Grid>
                <StackPanel x:Name="BubbleShelf" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,13,0">
                    <local:Icon Kind="Tray" Width="15" Height="15" VerticalAlignment="Center"/>
                    <local:Digits x:Name="BubbleShelfText" Text="0" FontSize="12.5" FontWeight="SemiBold"
                                  VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
